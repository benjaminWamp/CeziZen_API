// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id    Int  @id @default(autoincrement())
  clerkId String @unique
  email String  @unique 
  firstname  String 
  lastname String
  role Role @relation(fields: [roleId], references: [id])
  roleId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())
  articles Article[]
  sessions   ExerciseSession[]
}


model Role {
  id  Int  @id @default(autoincrement())
  name String @unique
  user User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())
}

model Article {
  id             Int   @id @default(autoincrement())
  label          String
  description    String
  content       String    
  category       Category @relation(fields: [categoryId], references: [id])
  categoryId     Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user User? @relation(fields : [userId], references: [id])
  userId Int? 
  images Image[]
  articleImages ArticleImage[] @relation("ArticleArticleImages")
}

model Category {
  id Int @id @default(autoincrement())
  label String 
  articles Article[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())
}

model Image {
  id        Int    @id @default(autoincrement())
  url       Bytes
  articles Article[]
}
model ArticleImage {
  id           Int        @id @default(autoincrement())
  path         String
  articles     Article[] @relation("ArticleArticleImages")
}

model Exercise {
  id           Int                @id @default(autoincrement())
  label        String
  times        String?           
  description  String?
  inspiration  Int?               
  expiration   Int?              
  apnea        Int?               
  sessions     ExerciseSession[]  @relation("ExerciseSessions")
}

model ExerciseSession {
  id            Int       @id @default(autoincrement())
  notes         String?
  endDate       DateTime?
  user          User      @relation(fields: [userId], references: [id])
  userId        Int
  exercise      Exercise  @relation("ExerciseSessions", fields: [exerciseId], references: [id])
  exerciseId    Int
}
